#  Infrastructure
DATABASE_URL=postgresql+asyncpg://orbit:orbit@localhost:5432/orbit
REDIS_URL=redis://localhost:6379/0
ENV=development

#  Auth JWT
JWT_SECRET_KEY=change-me-in-production

#  LLM Providers
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# ── Models ────────────────────────────────────────────────────────────────────
ORBIT_SCOUT_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
ORBIT_CLASSIFIER_MODEL=llama-3.3-70b-versatile
ORBIT_PLANNER_MODEL=llama-3.3-70b-versatile


#  Optional
ENRICHMENT_API_KEY=
EMAIL_PROVIDER_API_KEY=
