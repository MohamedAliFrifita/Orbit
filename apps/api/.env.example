DATABASE_URL=postgresql+asyncpg://orbit:orbit@localhost:5432/orbit
REDIS_URL=redis://localhost:6379/0
GEMINI_API_KEY=
ENRICHMENT_API_KEY=
EMAIL_PROVIDER_API_KEY=
ENV=development
ORBIT_MAX_EXHIBITORS=25
CLASSIFIER_BATCH_SIZE=3
# Optionnel : modèles Gemini (par défaut : gemini-2.5-flash)
# ORBIT_SCOUT_MODEL=gemini-2.5-flash
# LLM_FALLBACK_MODEL=gemini-2.5-flash
# ORBIT_CLASSIFIER_MODEL=gemini-2.5-flash
# ORBIT_PLANNER_MODEL=gemini-2.5-flash